     "zh": "这是书。",
     "vi": "Đây là sách."
    },
    {
     "speaker": "A",
     "zh": "这是什么书？",
     "vi": "Đây là sách gì?"
    },
    {
     "speaker": "B",
     "zh": "这是中文书。",
     "vi": "Đây là sách tiếng Trung."
    },
    {
     "speaker": "A",
     "zh": "这是谁的书？",
     "vi": "Đây là sách của ai?"
    },
    {
     "speaker": "B",
     "zh": "这是老师的书。",
     "vi": "Đây là sách của thầy giáo."
    },
    {
     "speaker": "A",
     "zh": "那是什么？",
     "vi": "Kia là cái gì?"
    },
    {
     "speaker": "B",
     "zh": "那是杂志。",
     "vi": "Kia là tạp chí."
    },
    {
     "speaker": "A",
     "zh": "那是什么杂志？",
     "vi": "Kia là tạp chí gì?"
    },
    {
     "speaker": "B",
     "zh": "那是英文杂志。",
     "vi": "Kia là tạp chí tiếng Anh."
    },
    {
     "speaker": "A",
     "zh": "那是谁的杂志？",
     "vi": "Kia là tạp chí của ai?"
    },
    {
     "speaker": "B",
     "zh": "那是我朋友的杂志。",
     "vi": "Kia là tạp chí của bạn tôi."
