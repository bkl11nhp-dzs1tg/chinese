 "texts": [
  {
   "title": "我学习汉语",
   "lines": [
    {
     "speaker": "麦克",
     "zh": "请问，你贵姓？",
     "vi": "Xin hỏi, bạn họ gì?"
    },
    {
     "speaker": "张东",
     "zh": "我姓张。",
     "vi": "Tôi họ Trương."
    },
    {
     "speaker": "麦克",
     "zh": "你叫什么名字？",
     "vi": "Bạn tên là gì?"
    },
    {
     "speaker": "张东",
     "zh": "我叫张东。",
     "vi": "Tôi tên là Trương Đông."
    },
    {
     "speaker": "麦克",
     "zh": "你是哪国人？",
     "vi": "Bạn là người nước nào?"
    },
    {
     "speaker": "张东",
     "zh": "我是中国人。你是哪国人？",
     "vi": "Tôi là người Trung Quốc. Bạn là người nước nào?"
    },
    {
     "speaker": "麦克",
     "zh": "我是美国人。",
     "vi": "Tôi là người Mỹ."
    },
    {
     "speaker": "张东",
     "zh": "你学习什么？",
     "vi": "Bạn học gì?"
    },
    {
     "speaker": "麦克",
     "zh": "我学习汉语。",
     "vi": "Tôi học tiếng Hán."
    },
    {
     "speaker": "张东",
     "zh": "汉语难吗？",
     "vi": "Tiếng Hán có khó không?"
    },
    {
     "speaker": "麦克",
     "zh": "汉字很难，发音不太难。",
     "vi": "Chữ Hán rất khó, phát âm không khó lắm."
    }
   ]
  },
  {
   "title": "这是什么书",
   "lines": [
    {
     "speaker": "A",
     "zh": "这是什么？",
     "vi": "Đây là cái gì?"
    },
    {
