  "texts": [
    {
      "title": "我学习汉语",
      "lines": [
        {
          "speaker": "麦克",
          "zh": "请问，你贵姓？",
          "vi": "Xin hỏi, bạn họ gì?"
        },
        {
          "speaker": "张东",
          "zh": "我姓张。",
          "vi": "Tôi họ Trương."
        },
        {
          "speaker": "麦克",
          "zh": "你叫什么名字？",
          "vi": "Bạn tên là gì?"
        },
        {
          "speaker": "张东",
          "zh": "我叫张东。",
          "vi": "Tôi tên là Trương Đông."
        },
        {
          "speaker": "麦克",
          "zh": "你是哪国人？",
          "vi": "Bạn là người nước nào?"
        },
        {
          "speaker": "张东",
          "zh": "我是中国人。你是哪国人？",
          "vi": "Tôi là người Trung Quốc. Bạn là người nước nào?"
        },
        {
          "speaker": "麦克",
          "zh": "我是美国人。",
          "vi": "Tôi là người Mỹ."
        },
        {
          "speaker": "张东",
          "zh": "你学习什么？",
          "vi": "Bạn học gì?"
        },
        {
          "speaker": "麦克",
          "zh": "我学习汉语。",
          "vi": "Tôi học tiếng Hán."
        },
        {
          "speaker": "张东",
          "zh": "汉语难吗？",
          "vi": "Tiếng Hán có khó không?"
        },
        {
          "speaker": "麦克",
          "zh": "汉字很难，发音不太难。",
          "vi": "Chữ Hán rất khó, phát âm không khó lắm."
        }
      ]
    },
    {
      "title": "这是什么书",
      "lines": [
        {
          "speaker": "A",
          "zh": "这是什么？",
          "vi": "Đây là cái gì?"
        },
        {
          "speaker": "B",
          "zh": "这是书。",
          "vi": "Đây là sách."
        },
        {
          "speaker": "A",
          "zh": "这是什么书？",
          "vi": "Đây là sách gì?"
        },
        {
          "speaker": "B",
          "zh": "这是中文书。",
          "vi": "Đây là sách tiếng Trung."
        },
        {
          "speaker": "A",
          "zh": "这是谁的书？",
          "vi": "Đây là sách của ai?"
        },
        {
          "speaker": "B",
          "zh": "这是老师的书。",
          "vi": "Đây là sách của thầy giáo."
        },
        {
          "speaker": "A",
          "zh": "那是什么？",
          "vi": "Kia là cái gì?"
        },
        {
          "speaker": "B",
          "zh": "那是杂志。",
          "vi": "Kia là tạp chí."
        },
        {
          "speaker": "A",
          "zh": "那是什么杂志？",
          "vi": "Kia là tạp chí gì?"
        },
        {
          "speaker": "B",
          "zh": "那是英文杂志。",
          "vi": "Kia là tạp chí tiếng Anh."
        },
        {
          "speaker": "A",
          "zh": "那是谁的杂志？",
          "vi": "Kia là tạp chí của ai?"
        },
        {
          "speaker": "B",
          "zh": "那是我朋友的杂志。",
          "vi": "Kia là tạp chí của bạn tôi."
        }
      ]
    }
  ],
  "grammar_points": [
    {
      "id": "L06-g1",
      "title": "Họ tên người Trung Quốc; hỏi họ tên",
      "note": "Họ đứng trước tên. Hỏi lịch sự: 您贵姓？ trả lời 我姓…; hỏi tên: 你叫什么名字？",
      "examples": [
        {
          "zh": "请问，你贵姓？",
          "vi": "Xin hỏi, bạn họ gì?"
        },
        {
          "zh": "我叫张东。",
          "vi": "Tôi tên là Trương Đông."
        }
      ]
    },
    {
      "id": "L06-g2",
      "title": "Đại từ nghi vấn 什么, 哪, 谁",
      "note": "什么 = cái gì; 哪 + 国 = nước nào; 谁 = ai. Đặt đúng vị trí của thành phần được hỏi, không đảo câu.",
      "examples": [
        {
          "zh": "你是哪国人？",
          "vi": "Bạn là người nước nào?"
        },
        {
          "zh": "这是谁的书？",
          "vi": "Đây là sách của ai?"
        }
      ]
    },
    {
      "id": "L06-g3",
      "title": "的 chỉ sở hữu",
      "note": "Danh từ/đại từ + 的 + danh từ = … của …",
      "examples": [
        {
          "zh": "这是老师的书。",
          "vi": "Đây là sách của thầy giáo."
        }
      ]
    }
  ]
}
