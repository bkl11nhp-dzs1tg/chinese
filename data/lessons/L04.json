  "texts": [
    {
      "title": "你去哪儿",
      "lines": [
        {
          "speaker": "A",
          "zh": "今天星期几？",
          "vi": "Hôm nay thứ mấy?"
        },
        {
          "speaker": "B",
          "zh": "今天星期二（一、三、四、五、六、天）。",
          "vi": "Hôm nay thứ ba (thứ hai, thứ tư, thứ năm, thứ sáu, thứ bảy, chủ nhật)."
        },
        {
          "speaker": "A",
          "zh": "你去哪儿？",
          "vi": "Bạn đi đâu?"
        },
        {
          "speaker": "B",
          "zh": "我去天安门，你去不去？",
          "vi": "Tôi đi Thiên An Môn, bạn có đi không?"
        },
        {
          "speaker": "A",
          "zh": "不去，我回学校。",
          "vi": "Không đi, tôi về trường."
        },
        {
          "speaker": "B",
          "zh": "再见！",
          "vi": "Tạm biệt!"
        },
        {
          "speaker": "A",
          "zh": "再见！",
          "vi": "Tạm biệt!"
        }
      ]
    },
    {
      "title": "对不起",
      "lines": [
        {
          "speaker": "A",
          "zh": "对不起！",
          "vi": "Xin lỗi!"
        },
        {
          "speaker": "B",
          "zh": "没关系！",
          "vi": "Không sao!"
        }
      ]
    }
  ],
  "grammar_points": [
    {
      "id": "L04-g1",
      "title": "Ngữ âm: z c s; thanh nhẹ; biến điệu 不",
      "note": "Học thanh mẫu z c s. 不 bù đứng trước thanh 4 đọc thành bú: 不去 bú qù, 不是 bú shì.",
      "examples": [
        {
          "zh": "我不去。",
          "vi": "Tôi không đi."
        }
      ]
    },
    {
      "id": "L04-g2",
      "title": "Hỏi thứ trong tuần",
      "note": "星期 + 一…六 = thứ hai … thứ bảy; 星期天/星期日 = chủ nhật. Hỏi: 今天星期几？",
      "examples": [
        {
          "zh": "今天星期几？",
          "vi": "Hôm nay thứ mấy?"
        }
      ]
    },
    {
      "id": "L04-g3",
      "title": "Câu hỏi chính phản (động từ + 不 + động từ)",
      "note": "Lặp động từ ở dạng khẳng định + phủ định để hỏi: 去不去 = có đi không.",
      "examples": [
        {
          "zh": "你去不去？",
          "vi": "Bạn có đi không?"
        }
      ]
    }
  ]
}
