  "texts": [
    {
      "title": "这是王老师",
      "lines": [
        {
          "speaker": "A",
          "zh": "这是王老师，这是我爸爸。",
          "vi": "Đây là thầy Vương, đây là bố tôi."
        },
        {
          "speaker": "B",
          "zh": "王老师，您好！",
          "vi": "Chào thầy Vương!"
        },
        {
          "speaker": "C",
          "zh": "您好！请进！请坐！请喝茶！",
          "vi": "Chào ông! Mời vào! Mời ngồi! Mời uống trà!"
        },
        {
          "speaker": "B",
          "zh": "谢谢！",
          "vi": "Cảm ơn!"
        },
        {
          "speaker": "C",
          "zh": "不客气！",
          "vi": "Không có gì!"
        },
        {
          "speaker": "C",
          "zh": "工作忙吗？",
          "vi": "Công việc có bận không?"
        },
        {
          "speaker": "B",
          "zh": "不太忙。",
          "vi": "Không bận lắm."
        },
        {
          "speaker": "C",
          "zh": "身体好吗？",
          "vi": "Sức khỏe tốt chứ?"
        },
        {
          "speaker": "B",
          "zh": "很好！",
          "vi": "Rất tốt!"
        }
      ]
    }
  ],
  "grammar_points": [
    {
      "id": "L05-g1",
      "title": "Ngữ âm: zh ch sh r và -i",
      "note": "zh ch sh r là âm uốn lưỡi. Sau zh ch sh r, chữ i đọc thành âm -i (không phải i thường): 是 shì, 吃 chī.",
      "examples": [
        {
          "zh": "这是王老师。",
          "vi": "Đây là thầy Vương."
        }
      ]
    },
    {
      "id": "L05-g2",
      "title": "Câu chữ 是",
      "note": "A 是 B = A là B. Phủ định: A 不是 B.",
      "examples": [
        {
          "zh": "这是我爸爸。",
          "vi": "Đây là bố tôi."
        }
      ]
    },
    {
      "id": "L05-g3",
      "title": "Câu mời với 请",
      "note": "请 + động từ = xin mời…",
      "examples": [
        {
          "zh": "请进！请坐！请喝茶！",
          "vi": "Mời vào! Mời ngồi! Mời uống trà!"
        }
      ]
    }
  ]
