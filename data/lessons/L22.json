  "texts": [
    {
      "title": "我打算请老师教我京剧",
      "lines": [
        {
          "speaker": "老师",
          "zh": "今天想请大家谈谈自己的爱好。谁先说？",
          "vi": "(Trong giờ học, thầy Vương bảo các bạn nói về sở thích) Hôm nay thầy muốn mời mọi người nói về sở thích của mình. Ai nói trước?"
        },
        {
          "speaker": "玛丽",
          "zh": "老师，让我先说吧。",
          "vi": "Thưa thầy, để em nói trước ạ."
        },
        {
          "speaker": "老师",
          "zh": "好，你说吧。你有什么爱好？",
          "vi": "Được, em nói đi. Em có sở thích gì?"
        },
        {
          "speaker": "玛丽",
          "zh": "我的爱好是看京剧。",
          "vi": "Sở thích của em là xem kinh kịch."
        },
        {
          "speaker": "老师",
          "zh": "你喜欢看京剧？",
          "vi": "Em thích xem kinh kịch à?"
        },
        {
          "speaker": "玛丽",
          "zh": "是啊，非常喜欢。我还想学唱京剧，打算请一个老师教我。",
          "vi": "Vâng, rất thích. Em còn muốn học hát kinh kịch, định mời một thầy dạy em."
        },
        {
          "speaker": "老师",
          "zh": "麦克，你喜欢做什么？",
          "vi": "Mike, em thích làm gì?"
        },
        {
          "speaker": "麦克",
          "zh": "我喜欢玩电脑。",
          "vi": "Em thích chơi máy tính."
        },
        {
          "speaker": "老师",
          "zh": "罗兰呢？",
          "vi": "Còn Rollan?"
        },
        {
          "speaker": "罗兰",
          "zh": "我喜欢听音乐，下课以后，听听音乐或者跟朋友聊聊天儿，感到心情很愉快。",
          "vi": "Em thích nghe nhạc. Tan học nghe nhạc hoặc nói chuyện với bạn bè, em thấy tâm trạng rất vui vẻ."
        },
        {
          "speaker": "老师",
          "zh": "田中业余时间常常做什么？",
          "vi": "Tanaka lúc rảnh thường làm gì?"
        },
        {
          "speaker": "田中",
          "zh": "我来中国以前就对书法特别感兴趣。今年公司派我来中国，我非常高兴。现在我正跟一个老师学书法，还学画中国画儿。",
          "vi": "Trước khi sang Trung Quốc em đã đặc biệt hứng thú với thư pháp. Năm nay công ty cử em sang Trung Quốc, em rất vui. Bây giờ em đang theo một thầy học thư pháp, còn học vẽ tranh Trung Quốc nữa."
        }
      ]
    }
  ],
  "grammar_points": [
    {
      "id": "L22-g1",
      "title": "Câu kiêm ngữ",
      "note": "Động từ 1 (请, 让, 叫, 派) + tân ngữ (cũng là chủ ngữ của động từ 2) + động từ 2.",
      "examples": [
        {
          "zh": "我打算请老师教我京剧。",
          "vi": "Tôi định mời thầy dạy tôi kinh kịch."
        },
        {
          "zh": "老师，让我先说吧。",
          "vi": "Thầy để em nói trước ạ."
        },
        {
          "zh": "公司派我来中国。",
          "vi": "Công ty cử tôi sang Trung Quốc."
        }
      ]
    },
    {
      "id": "L22-g2",
      "title": "以前 và 以后",
      "note": "… 以前 = trước khi …; … 以后 = sau khi …",
      "examples": [
        {
          "zh": "我来中国以前就对书法特别感兴趣。",
          "vi": "Trước khi sang Trung Quốc tôi đã rất hứng thú với thư pháp."
        }
      ]
    },
    {
      "id": "L22-g3",
      "title": "对 … 感兴趣",
      "note": "对 + sự vật + 感兴趣 = có hứng thú với …",
      "examples": [
        {
          "zh": "我对书法很感兴趣。",
          "vi": "Tôi rất hứng thú với thư pháp."
        }
      ]
    }
  ]
}
