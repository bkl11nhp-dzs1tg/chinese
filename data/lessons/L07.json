  "texts": [
    {
      "title": "你吃什么",
      "lines": [
        {
          "speaker": "麦克",
          "zh": "中午你去哪儿吃饭？",
          "vi": "(Trong phòng học) Trưa nay bạn đi đâu ăn cơm?"
        },
        {
          "speaker": "玛丽",
          "zh": "我去食堂。",
          "vi": "Tôi đến nhà ăn."
        },
        {
          "speaker": "麦克",
          "zh": "你吃什么？",
          "vi": "(Trong nhà ăn) Bạn ăn gì?"
        },
        {
          "speaker": "玛丽",
          "zh": "我吃馒头。",
          "vi": "Tôi ăn màn thầu."
        },
        {
          "speaker": "麦克",
          "zh": "你要几个？",
          "vi": "Bạn muốn mấy cái?"
        },
        {
          "speaker": "玛丽",
          "zh": "一个。你吃吗？",
          "vi": "Một cái. Bạn ăn không?"
        },
        {
          "speaker": "麦克",
          "zh": "不吃，我吃米饭。你喝什么？",
          "vi": "Không ăn, tôi ăn cơm. Bạn uống gì?"
        },
        {
          "speaker": "玛丽",
          "zh": "我要一碗鸡蛋汤。你喝吗？",
          "vi": "Tôi muốn một bát canh trứng. Bạn uống không?"
        },
        {
          "speaker": "麦克",
          "zh": "不喝，我喝啤酒。",
          "vi": "Không, tôi uống bia."
        },
        {
          "speaker": "玛丽",
          "zh": "这些是什么？",
          "vi": "Những cái này là gì?"
        },
        {
          "speaker": "麦克",
          "zh": "这是饺子，这是包子，那是面条。",
          "vi": "Đây là sủi cảo, đây là bánh bao, kia là mì sợi."
        }
      ]
    }
  ],
  "grammar_points": [
    {
      "id": "L07-g1",
      "title": "Biến điệu của 一",
      "note": "一 đứng trước thanh 4 đọc yí (一个 yí ge); đứng trước thanh 1, 2, 3 đọc yì (一碗 yì wǎn); đứng một mình hoặc cuối từ đọc yī.",
      "examples": [
        {
          "zh": "我要一碗鸡蛋汤。",
          "vi": "Tôi muốn một bát canh trứng."
        }
      ]
    },
    {
      "id": "L07-g2",
      "title": "Lượng từ: số + lượng từ + danh từ",
      "note": "Giữa số và danh từ phải có lượng từ: 一个馒头, 一碗米饭. 个 là lượng từ dùng phổ biến nhất.",
      "examples": [
        {
          "zh": "你要几个？",
          "vi": "Bạn muốn mấy cái?"
        }
      ]
    }
  ]
}
